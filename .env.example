# Enterprise RAG Demo - Environment Variables
# Copy this to .env and fill in your values

# Required for LLM-powered answers (optional: works without it but returns raw chunks)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Auth (set to "true" to enable JWT auth)
RAG_AUTH_ENABLED=false
RAG_AUTH_SECRET_KEY=change-me-in-production

# Server
RAG_SERVER_HOST=0.0.0.0
RAG_SERVER_PORT=8000
